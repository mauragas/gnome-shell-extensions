<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.monitor-layout-switcher"
          path="/org/gnome/shell/extensions/monitor-layout-switcher/">

    <!-- JSON array of schema v2 layout objects. Each layout:
         {
           "id": "unique-id",
           "name": "Human Label",
           "schemaVersion": 2,
           "monitors": [
             {
               "identity": {"vendor": "...", "product": "...", "serial": "..."},
               "savedConnector": "&lt;connector-name&gt;",
               "isBuiltin": false,
               "transform": 0,
               "scale": 1.0,
               "modeHint": {"width": 1920, "height": 1080, "rate": 60.0},
               "savedModeId": "&lt;mode-id&gt;",
               "preferredSize": {"width": 1920, "height": 1080},
               "layout": {"x": 0, "y": 0, "isPrimary": true}
             }
           ]
         }
         Schema v1 layouts are migrated in memory when loaded.
    -->
    <key name="layouts" type="s">
      <default>''</default>
      <summary>Saved monitor layouts</summary>
      <description>JSON array of layout configurations</description>
    </key>

    <key name="toggle-last-two-layouts" type="as">
      <default>['&lt;Super&gt;F7']</default>
      <summary>Open the monitor layout switcher</summary>
      <description>Keyboard shortcut used to open the layout switcher overlay, cycle through saved layouts, and apply the selected layout.</description>
    </key>

  </schema>
</schemalist>
