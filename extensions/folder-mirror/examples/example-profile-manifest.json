{
  "description": "Generic validation profile set for local development mirror workflows.",
  "globalExcludes": [
    ".git",
    ".svn",
    ".hg",
    ".vs",
    ".angular/cache",
    ".next",
    ".nuxt",
    ".parcel-cache",
    ".sass-cache",
    ".turbo",
    "bin",
    "obj",
    "node_modules",
    "out",
    "dist",
    "build",
    "coverage",
    "TestResults",
    ".pytest_cache",
    "__pycache__",
    ".cache",
    ".eslintcache",
    "tmp",
    "temp",
    "*.tmp",
    "*.swp",
    "*.swo",
    "*.bak",
    ".DS_Store",
    "Thumbs.db"
  ],
  "profiles": [
    {
      "id": "example-container-mirror",
      "name": "Example Container Mirror",
      "enabled": true,
      "paused": false,
      "sourcePath": "/path/to/source/project-alpha",
      "targetPath": "/path/to/mirrors/container/project-alpha",
      "mode": "two-way",
      "watchMode": true,
      "runAtLogin": true,
      "conflictPolicy": "prefer-newer",
      "deleteProtection": true,
      "globalExcludesEnabled": true,
      "excludeGitIgnored": true,
      "includeGitMetadata": false,
      "excludeRules": []
    },
    {
      "id": "example-vm-mirror-beta",
      "name": "Example VM Mirror Beta",
      "enabled": true,
      "paused": false,
      "sourcePath": "/path/to/source/project-beta",
      "targetPath": "/path/to/mirrors/vm/project-beta",
      "mode": "two-way",
      "watchMode": true,
      "runAtLogin": true,
      "conflictPolicy": "prefer-newer",
      "deleteProtection": true,
      "globalExcludesEnabled": true,
      "excludeGitIgnored": true,
      "includeGitMetadata": false,
      "excludeRules": []
    },
    {
      "id": "example-vm-mirror-gamma",
      "name": "Example VM Mirror Gamma",
      "enabled": true,
      "paused": false,
      "sourcePath": "/path/to/source/project-gamma",
      "targetPath": "/path/to/mirrors/vm/project-gamma",
      "mode": "two-way",
      "watchMode": true,
      "runAtLogin": true,
      "conflictPolicy": "prefer-newer",
      "deleteProtection": true,
      "globalExcludesEnabled": true,
      "excludeGitIgnored": true,
      "includeGitMetadata": false,
      "excludeRules": []
    }
  ]
}
